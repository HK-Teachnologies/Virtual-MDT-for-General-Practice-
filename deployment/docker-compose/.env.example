# Copy to .env and fill in real values. Never commit the real .env file.
META_API_KEY=your-meta-model-api-key-here
DATABASE_URL=postgresql://user:password@db:5432/virtualmdt
# Long random string signing the login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
POSTGRES_PASSWORD=changeme
# Default admin seeded at backend startup (skipped if the user already exists).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production
