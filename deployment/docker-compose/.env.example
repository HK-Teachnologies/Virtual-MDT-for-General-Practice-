# Copy to .env and fill in real values. Never commit the real .env file.
META_API_KEY=your-meta-model-api-key-here
# Background MDT pipeline. "echo" never calls a model (safe default);
# set "litellm" plus a key to run the real agent.
LLM_PROVIDER=echo
LLM_API_KEY=
# Meta Model API (Muse Spark + Voice Transcribe) — verified working values:
# LLM_API_BASE=https://api.meta.ai/v1
# LLM_MODEL=openai/muse-spark-1.3
# LLM_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
LLM_API_BASE=
LLM_MODEL=gpt-4o-mini
LLM_TRANSCRIBE_MODEL=whisper-1
LLM_EMBED_MODEL=text-embedding-3-small
# Local embedding server (sentence-transformers). Embeddings stay in-house;
# chat/transcription still use the provider above. Build args pin the same
# models into the image so runtime and baked weights cannot diverge.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DATABASE_URL=postgresql://user:password@db:5432/virtualmdt
# Long random string signing the login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
POSTGRES_PASSWORD=changeme
# Default admin seeded at backend startup (skipped if the user already exists).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production
